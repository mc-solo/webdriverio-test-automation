# Copy to .env and adjust. Never commit a real .env — it is git-ignored.
# All values have safe defaults in config/environments.ts; only set what
# you want to change. No real credentials belong here.

# Site under test (default: the public demo site)
BASE_URL=https://the-internet.herokuapp.com

# Browser (chrome or firefox) and headless mode
BROWSER=chrome
# Comma-separated list to run on several browsers, e.g. chrome,firefox
# (overrides BROWSER when set; unknown names are ignored)
# BROWSERS=chrome,firefox
HEADLESS=true
WINDOW_SIZE=1280,800

# Timeouts in milliseconds
WAITFOR_TIMEOUT=10000
CONNECTION_RETRY_TIMEOUT=120000
CONNECTION_RETRY_COUNT=3
MOCHA_TIMEOUT=60000

# Parallel browser instances
MAX_INSTANCES=1

# wdio log level: info | warn | error | debug
LOG_LEVEL=info
